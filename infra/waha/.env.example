# =============================================================================
#  PLANTILLA DE VARIABLES - WAHA / Panel de WhatsApp Rent & Go Punta Cana
# =============================================================================
#
#  COMO SE USA:
#   1. Copia este archivo y llamalo  .env   (sin el ".example")
#   2. Cambia TODOS los valores de ejemplo por los reales
#   3. NUNCA subas el .env a GitHub. Este repositorio es publico.
#      Antes de hacer commit, verifica que .env este en el .gitignore.
#
#  Todos los valores de abajo son FALSOS a proposito. Si dejas alguno tal cual,
#  no va a funcionar - y si funcionara, seria inseguro.
#
#  Para generar claves largas y aleatorias:
#     openssl rand -hex 32
#  o entra a https://www.random.org/strings/ y pide una cadena larga.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. SEGURIDAD DE LA API
# -----------------------------------------------------------------------------

# Clave maestra de la API de WAHA. Es la que protege tu numero de WhatsApp:
# quien la tenga puede mandar mensajes en tu nombre. Tratala como la clave
# del banco. El sitio en Vercel la usa en el header "X-Api-Key".
# IMPORTANTE: este mismo valor va en Vercel como WAHA_API_KEY.
# Minimo 32 caracteres, sin espacios.
WAHA_API_KEY=EJEMPLO_FALSO_cambiame_ya_0000000000000000000000000000

# Usuario y clave para entrar al panel web de WAHA (donde escaneas el QR).
# Son distintos de la clave de arriba. No los reutilices de otro servicio.
WAHA_DASHBOARD_USERNAME=usuario-ejemplo-cambiame
WAHA_DASHBOARD_PASSWORD=EJEMPLO_FALSO_clave_del_dashboard_cambiame_1111


# -----------------------------------------------------------------------------
# 2. SESION DE WHATSAPP
# -----------------------------------------------------------------------------

# Nombre interno de la sesion. Puede ser cualquiera, pero tiene que ser
# EXACTAMENTE igual al valor de WAHA_SESSION que pongas en Vercel.
# Si no coinciden, el panel manda mensajes "a una sesion que no existe".
WAHA_SESSION=default

# Segundos que espera al encender antes de arrancar la sesion.
# Le da tiempo al servidor de montar el disco donde vive la sesion.
WAHA_AUTO_START_DELAY_SECONDS=5


# -----------------------------------------------------------------------------
# 3. WEBHOOK (como WAHA le avisa al sitio que llego un mensaje)
# -----------------------------------------------------------------------------

# A donde WAHA envia cada mensaje que entra.
# En produccion es exactamente esta:
#   https://www.rentandgopc.com/api/wa/webhook
# Si estas probando en tu computadora, usa un tunel tipo ngrok y pon esa URL.
WHATSAPP_HOOK_URL=https://ejemplo-falso.invalid/api/wa/webhook

# Que eventos quieres recibir. "message" = mensajes que TE escriben.
# Opcional: "message,session.status" para que el panel tambien sepa
# cuando la sesion se desconecta.
WHATSAPP_HOOK_EVENTS=message

# Secreto compartido para firmar los webhooks (HMAC-SHA512).
# WAHA firma el mensaje con este secreto y el sitio comprueba la firma.
# Sin esto, cualquiera podria mandarle mensajes falsos a tu panel.
# IMPORTANTE: este mismo valor va en Vercel como WAHA_WEBHOOK_SECRET.
# Minimo 32 caracteres. NO puede ser igual a WAHA_API_KEY.
WHATSAPP_HOOK_HMAC_KEY=EJEMPLO_FALSO_secreto_del_webhook_cambiame_2222


# -----------------------------------------------------------------------------
# 4. RED Y SERVIDOR
# -----------------------------------------------------------------------------

# URL publica donde vive WAHA. Sirve para armar los enlaces de las fotos
# y audios que recibes.
#  - En Railway: el dominio que te genera, con https://
#    ejemplo real tendria esta forma: https://waha-production-xxxx.up.railway.app
#  - En tu computadora: http://localhost:3000
WAHA_PUBLIC_URL=https://ejemplo-falso.invalid

# Puerto en tu computadora para probar local. En Railway se ignora.
WAHA_LOCAL_PORT=3000

# Zona horaria. Dejala asi para Republica Dominicana: las horas de los logs
# y el horario de atencion del panel van a cuadrar con la hora de aqui.
TZ=America/Santo_Domingo


# -----------------------------------------------------------------------------
# 5. ARCHIVOS Y LOGS
# -----------------------------------------------------------------------------

# Segundos que se guarda cada foto/audio recibido antes de borrarse.
# 180 = 3 minutos, suficiente para que el panel lo descargue.
# 0 = no borrar nunca (ojo: con el tiempo llena el disco y te cobran mas).
WHATSAPP_FILES_LIFETIME=180

# Detalle de los logs: error, warn, info, debug, trace.
# Dejalo en "info". Solo ponlo en "debug" mientras investigas un problema,
# y devuelvelo a "info" despues (debug genera muchisimo texto).
WAHA_LOG_LEVEL=info

# Imprimir el codigo QR en los logs del servidor.
# Util como plan B si el panel web no carga y hay que vincular el telefono.
WAHA_PRINT_QR=True


# =============================================================================
#  ESTAS NO VAN AQUI: VAN EN VERCEL
# =============================================================================
#  Las siguientes variables NO se ponen en este archivo ni en Railway.
#  Se ponen en el dashboard de Vercel (Settings -> Environment Variables):
#
#    WAHA_URL             -> la URL publica de Railway (igual a WAHA_PUBLIC_URL)
#    WAHA_API_KEY         -> el MISMO valor de WAHA_API_KEY de arriba
#    WAHA_SESSION         -> el MISMO valor de WAHA_SESSION de arriba
#    WAHA_WEBHOOK_SECRET  -> el MISMO valor de WHATSAPP_HOOK_HMAC_KEY de arriba
#    PANEL_PASSWORD       -> la clave para entrar al panel del sitio
#    PANEL_SECRET         -> secreto para firmar la sesion del panel
#
#  Detalle completo en README-es.md, paso 4.
# =============================================================================
